# Copy this file to .env and replace every value before starting Docker Compose.
POSTGRES_DB=sefaz_downloader
POSTGRES_USER=sefaz_downloader
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_PORT=8000

# Used only by config.settings.development for local commands outside Docker.
# Set DEV_MODE=True to use the ignored SQLite database and a private directory
# under the current user's profile.
DEV_MODE=False
# Optional local root for development notes, certificate key material and the
# encrypted certificate vault. It must not be committed or shared.
# DEV_STORAGE_ROOT=/absolute/path/to/sefaz-local-runtime

# Use absolute paths on the Docker host. Keep certificate files outside the
# shared notes directory and outside the repository.
# Notes and per-client encrypted certificates remain outside the repository.
NOTES_HOST_DIR=/absolute/path/to/sefaz-notes
CERTIFICATES_HOST_DIR=/absolute/path/to/sefaz-certificates
CERTIFICATE_PUBLIC_HOST_DIR=/absolute/path/to/sefaz-certificate-public
# Docker Compose supplies its container-only key paths and creates the key pair
# without replacing existing deployment keys. Do not set those /dados/... paths
# for direct local development; DEV_MODE uses the current user's private
# .sefaz_downloader directory instead.

# Leave empty until the preflight succeeds. Enable only `homologation` for the
# controlled first test; never include `production` without recorded approval.
SEFAZ_ENABLED_ENVIRONMENTS=
