# Copy this file to .env and replace every value before starting Docker Compose.
POSTGRES_DB=sefaz_downloader
POSTGRES_USER=sefaz_downloader
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_PORT=8000

# Use absolute paths on the Docker host. Keep certificate files outside the
# shared notes directory and outside the repository.
NOTES_HOST_DIR=/absolute/path/to/sefaz-notes
CERTIFICATES_HOST_DIR=/absolute/path/to/sefaz-certificates
# Path visible only to the worker container. Generate it once with:
# docker compose run --rm worker python manage.py generate_certificate_key
CERTIFICATE_ENCRYPTION_KEY_FILE=/dados/certificados/.secrets/certificate-vault.key
